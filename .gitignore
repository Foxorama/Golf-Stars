node_modules
dist
dist-ssr
*.local
.DS_Store
.vite

# SIGNING KEYS — never commit. This repo is public, and the Android upload key is PERMANENT:
# Android refuses to update a package whose signature changed, so a leaked or lost key strands
# every existing install forever with no recovery. The key reaches CI as the
# `ANDROID_KEYSTORE_BASE64` secret (see .github/workflows/android.yml), never as a file in git.
# Generate it OUTSIDE this folder as well — these patterns are the second line of defence, not the first.
*.jks
*.keystore
keystore.properties
key.properties

# Art: keep regenerable prompt logs, ignore the heavy generated source images.
art/generated/

# Android launcher/splash SOURCE art — derived from public/icon-512.png by
# `npm run android:assets`. The DOWNSCALED per-density output under android/app/src/main/res/
# IS committed (CI packages it without regenerating); these oversized intermediates are not.
assets/

# Vite writes these beside a TS config while loading it; they are transient build artifacts.
vite.config.ts.timestamp-*.mjs

# Scratch output from the preview/measurement scripts (screenshots, probe dumps).
.tmp/

# Claude Code local state. `.claude/skills/` IS tracked on purpose — a repo skill is shared work —
# so these are named individually rather than ignoring `.claude/` wholesale.
#   launch.json  — the preview-server config, and it holds an ABSOLUTE path to whichever node this
#                  machine uses (node is not on PATH here). Committing it breaks the preview for
#                  anyone else and puts a home directory in a public repo.
#   worktrees/   — throwaway checkouts. This was only in `.git/info/exclude`, which is per-clone and
#                  travels with nobody, so a fresh clone had nothing stopping it committing one.
.claude/launch.json
.claude/worktrees/
