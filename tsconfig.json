{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    // `tests/chromium.ts` re-exports the plain-ESM `scripts/chromium.mjs` — the one Chromium lookup,
    // which has to be .mjs so the `scripts/*-preview.mjs` rigs can import it without a build step.
    // `checkJs` stays off: scripts/ is dev tooling, not shipped code, and is not type-checked.
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
